# ---- Mode -------------------------------------------------------------------
# mock       = deterministic adapters for model/Relay/Superserve; real local Durable Actors persistence
# integrated = real Anthropic model, Superserve VMs, Agent Relay (requires every credential below)
MYCORR_MODE=mock

# ---- Durable Actors (local runtime: `bun run actors:dev`) -------------------
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100
DURABLE_ACTORS_PROJECT_ID=local
# DURABLE_ACTORS_SECRET=            # only if the actor server runs with a secret

# ---- API / coordinator -------------------------------------------------------
API_PORT=3000
# URL agent VMs use to reach this backend. In integrated mode: the Superserve preview URL
# of the sandbox that hosts the backend, e.g. https://3000-<sandbox-id>.sandbox.superserve.ai
PUBLIC_BACKEND_URL=http://127.0.0.1:3000
AGENT_TOKEN_SECRET=change-me-to-a-long-random-string
SERVICE_TOKEN=change-me-too

# ---- Model (OpenAI) -------------------------------------------------------------
# MODEL_PROVIDER=openai|mock         # defaults: openai in integrated mode, mock in mock mode
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=                  # optional
MODEL_ID=gpt-5.4-mini               # planning agents
QUESTION_MODEL_ID=gpt-5.4           # onboarding question agent (mini completes too early)
MODEL_EFFORT=low

# ---- Superserve (agent VMs + published backend port) --------------------------
# SUPERSERVE_API_KEY=ss_live_...
# SUPERSERVE_BASE_URL=https://api.superserve.ai
# SUPERSERVE_SANDBOX_ID=            # sandbox that runs the backend and publishes API_PORT
# SUPERSERVE_PREVIEW_TOKEN=         # `superserve preview token <id> 3000` (private port)
SUPERSERVE_PREVIEW_HEADER=X-Superserve-Preview-Token
SUPERSERVE_AGENT_TEMPLATE=superserve/base

# ---- Agent Relay (server-side bootstrap; per-trip refs live in TripActor) -----
# RELAY_WORKSPACE_KEY=
# RELAY_BASE_URL=

# ---- Worker --------------------------------------------------------------------
WORKER_POLL_MS=1000
WORKER_LEASE_MS=120000

# ---- Optional webhook (not implemented in the demo slice) ------------------------
# WEBHOOK_URL=
# WEBHOOK_SECRET=
